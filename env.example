# Copy this file to ".env" (or set these as real environment variables) to
# enable the OPTIONAL connectors. Nothing below is required for the app's
# core 4 sources (Himalayas, Arbeitnow, Remotive, We Work Remotely) to work.

# --- Adzuna (optional) -------------------------------------------------
# Free developer account: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=it

# --- Gmail connector for LinkedIn/Indeed alert emails (optional, UNTESTED) --
# See gmail_connector.py for the full setup. Requires:
#   pip install -r requirements-gmail.txt
ENABLE_GMAIL_CONNECTOR=0
GMAIL_CREDENTIALS_JSON=credentials.json
GMAIL_TOKEN_JSON=token.json
GMAIL_LABEL=JobAlerts
