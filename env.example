# Copy this file to ".env" (or set these as real environment variables, or
# Streamlit Cloud "Secrets") to enable the OPTIONAL connectors. Nothing
# below is required for the app's core free sources (Himalayas, Arbeitnow,
# Remotive, We Work Remotely, The Muse, Remote OK) to work.

# --- Adzuna (optional) -------------------------------------------------
# Free developer account: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=it

# --- Jooble (optional) - separate keys for Italy and Switzerland ------
# Free account: https://jooble.org/api/about  (limited daily quota - the
# app caches results and this connector can be switched off entirely in
# the "Fonti aggregatore attive" multiselect)
JOOBLE_API_KEY_IT=
JOOBLE_API_KEY_CH=

# --- The Muse (optional - works without a key, raises the quota with one)
THE_MUSE_API_KEY=

# --- Gmail connector for LinkedIn/Indeed alert emails (optional, UNTESTED) --
# See GMAIL_OAUTH_SETUP.md for the full setup. Requires:
#   pip install -r requirements-gmail.txt
ENABLE_GMAIL_CONNECTOR=0
GMAIL_CREDENTIALS_JSON=credentials.json
GMAIL_TOKEN_JSON=token.json
GMAIL_LABEL_LINKEDIN=JOB-ALERTS/LinkedIn
GMAIL_LABEL_INDEED=JOB-ALERTS/Indeed
